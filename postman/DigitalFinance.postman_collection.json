{
  "info": {
    "name": "Digital Finance via Carland",
    "description": "Calls carland-service, not Digital Finance directly. The ApiKey stays on the server.\n\nResponse body is the upstream JSON unchanged.\n\nSet accessToken (Bearer from login) before Send.\nbaseUrl default is the public gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://digital-innovation.agency/carland/server-carland"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "RequestIdentifier",
            "value": "{{$guid}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/digital-finance/info/balance"
      }
    },
    {
      "name": "Expenses",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "RequestIdentifier",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"StartDate\": \"2026-10-01\",\n  \"EndDate\": \"2026-10-21\",\n  \"Offset\": 0,\n  \"Limit\": 20\n}"
        },
        "url": "{{baseUrl}}/api/v1/digital-finance/info/expenses"
      }
    },
    {
      "name": "Payments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "RequestIdentifier",
            "value": "{{$guid}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"StartDate\": \"2026-10-01\",\n  \"EndDate\": \"2026-10-21\",\n  \"Offset\": 0,\n  \"Limit\": 20\n}"
        },
        "url": "{{baseUrl}}/api/v1/digital-finance/info/payments"
      }
    }
  ]
}
