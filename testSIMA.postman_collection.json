{
  "info": {
    "_postman_id": "a1b2c3d4-sima-test-0001",
    "name": "testSIMA",
    "description": "SIMA KYC tests. 1) Direct SIMA — Pre-request HMAC (Identifier 1155). 2) Carland proxy — POST /api/v1/sima/test/identity/verify (service signs + forwards). Always fresh idempotencyKey. Replace pin/documentNumber/livePhoto.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Direct SIMA — Verify Citizen",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const SIMA_IDENTIFIER = '1155';",
              "const SIMA_HMAC_SECRET = '78TDFSBSDILSDFLMSDFIRASE98EMMAS7';",
              "const SIMA_AUTH_SCHEME = 'HMACSHA256';",
              "",
              "let obj = JSON.parse(pm.request.body.raw);",
              "",
              "if (!obj.livePhoto || String(obj.livePhoto).length < 500) {",
              "  console.error('LIVEPHOTO EKSIK/KISA! Body uzunlugu=', (pm.request.body.raw || '').length, 'livePhoto=', obj.livePhoto ? String(obj.livePhoto).length : 0);",
              "  throw new Error('livePhoto yok veya cok kisa. Desktop testSIMA collection dosyasini yeniden Import et, Body tabinda livePhoto dolu olsun.');",
              "}",
              "",
              "obj.idempotencyKey = (typeof crypto !== 'undefined' && crypto.randomUUID)",
              "  ? crypto.randomUUID()",
              "  : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
              "      const r = Math.random() * 16 | 0;",
              "      const v = c === 'x' ? r : (r & 0x3 | 0x8);",
              "      return v.toString(16);",
              "    });",
              "",
              "const minified = JSON.stringify(obj);",
              "pm.request.body.update({ mode: 'raw', raw: minified });",
              "",
              "const sig = CryptoJS.HmacSHA256(minified, SIMA_HMAC_SECRET).toString(CryptoJS.enc.Base64);",
              "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
              "pm.request.headers.upsert({ key: 'Identifier', value: SIMA_IDENTIFIER });",
              "pm.request.headers.upsert({ key: 'Auth-Scheme', value: SIMA_AUTH_SCHEME });",
              "pm.request.headers.upsert({ key: 'Signature', value: sig });",
              "console.log('idempotencyKey=', obj.idempotencyKey);",
              "console.log('bodyBytes=', minified.length, 'livePhotoLen=', String(obj.livePhoto).length);",
              "console.log('signature=', sig);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Identifier",
            "value": "1155"
          },
          {
            "key": "Auth-Scheme",
            "value": "HMACSHA256"
          },
          {
            "key": "Signature",
            "value": "SET_BY_PREREQUEST_SCRIPT"
          },
          {
            "key": "DeviceInfo",
            "value": "Postman-test"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"pin\":\"5N1BKPG\",\"documentNumber\":\"AA5299931\",\"livePhoto\":\"\",\"idempotencyKey\":\"will-be-replaced-by-prerequest\"}"
        },
        "url": "https://pre-biosign-biometric-kyc.sima.az/api/v1/kyc/identity/verify",
        "description": "Verify Citizen. Pre-request sets Signature (HMAC-SHA256). Replace pin/documentNumber/livePhoto with real test data. XOR: documentNumber OR birthDate only."
      },
      "response": []
    },
    {
      "name": "Carland — /api/v1/sima/test/identity/verify",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pin\": \"5N1BKPG\",\n  \"documentNumber\": \"AA5299931\",\n  \"livePhoto\": \"PASTE_JPEG_BASE64_HERE\"\n}"
        },
        "url": {
          "raw": "http://localhost:9091/api/v1/sima/test/identity/verify",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "9091",
          "path": [
            "api",
            "v1",
            "sima",
            "test",
            "identity",
            "verify"
          ]
        },
        "description": "Carland signs with Identifier 1155 + HMAC and POSTs to https://pre-biosign-biometric-kyc.sima.az/api/v1/kyc/identity/verify. No Signature header needed here. livePhoto = JPEG Base64. XOR: documentNumber OR birthDate. Fresh idempotencyKey generated in service."
      },
      "response": []
    }
  ]
}