    {
      "name": "Direct SIMA — Verify Citizen (Base64 body)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const SIMA_IDENTIFIER = '1155';",
              "const SIMA_HMAC_SECRET = '78TDFSBSDILSDFLMSDFIRASE98EMMAS7';",
              "const SIMA_AUTH_SCHEME = 'HMACSHA256';",
              "",
              "let obj = JSON.parse(pm.request.body.raw);",
              "",
              "if (!obj.livePhoto || String(obj.livePhoto).length < 500) {",
              "  throw new Error('livePhoto yok veya cok kisa. Body-ye JPEG Base64 yapistir (Flutter ayni alani gonderecek).');",
              "  throw new Error('livePhoto yok veya cok kisa. Body-ye JPEG Base64 yapistir (Flutter ayni alani gonderecek).');",
              "}",
              "",
              "obj.idempotencyKey = (typeof crypto !== 'undefined' && crypto.randomUUID)",
              "  ? crypto.randomUUID()",
              "  : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {",
              "      const r = Math.random() * 16 | 0;",
              "      const v = c === 'x' ? r : (r & 0x3 | 0x8);",
              "      return v.toString(16);",
              "    });",
              "",
              "const minified = JSON.stringify(obj);",
              "pm.request.body.update({ mode: 'raw', raw: minified });",
              "",
              "const sig = CryptoJS.HmacSHA256(minified, SIMA_HMAC_SECRET).toString(CryptoJS.enc.Base64);",
              "pm.request.headers.upsert({ key: 'Content-Type', value: 'application/json' });",
              "pm.request.headers.upsert({ key: 'Identifier', value: SIMA_IDENTIFIER });",
              "pm.request.headers.upsert({ key: 'Auth-Scheme', value: SIMA_AUTH_SCHEME });",
              "pm.request.headers.upsert({ key: 'Signature', value: sig });",
              "console.log('idempotencyKey=', obj.idempotencyKey);",
              "console.log('bodyBytes=', minified.length, 'livePhotoLen=', String(obj.livePhoto).length);",
              "console.log('signature=', sig);"
            ]
          }
        }
      ],
